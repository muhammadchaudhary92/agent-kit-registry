{
  "id": "roo-code",
  "name": "Roo Code",
  "order": 130,
  "description": "VS Code extension agent (Cline fork).",
  "detect": {
    "paths": [
      "{appsupport}/Code/User/globalStorage/rooveterinaryinc.roo-cline"
    ]
  },
  "kinds": {
    "mcp": {
      "support": "guided",
      "transports": [
        "stdio",
        "http",
        "sse"
      ],
      "default_scope": "user",
      "shape": {
        "stdio": {
          "command": "{command}",
          "args": "{args}",
          "env": "{env}",
          "disabled": false
        },
        "http": {
          "type": "streamable-http",
          "url": "{url}",
          "headers": "{headers}"
        },
        "sse": {
          "type": "sse",
          "url": "{url}",
          "headers": "{headers}"
        }
      },
      "windows_wrap": "cmd",
      "methods": [
        {
          "method": "config-file",
          "format": "json",
          "root": [
            "mcpServers"
          ],
          "require_dir": true,
          "scopes": {
            "user": {
              "file": {
                "all": "{appsupport}/Code/User/globalStorage/rooveterinaryinc.roo-cline/settings/mcp_settings.json"
              }
            },
            "project": {
              "file": {
                "all": "{project}/.roo/mcp.json"
              }
            }
          }
        }
      ],
      "notes": "Not verified. Confirm the file with the user, then pass --config-path to apply."
    },
    "skill": {
      "support": "none"
    },
    "plugin": {
      "support": "none"
    },
    "extension": {
      "support": "none"
    }
  },
  "verified": {
    "date": "2026-11-20",
    "confidence": "low",
    "sources": []
  }
}
