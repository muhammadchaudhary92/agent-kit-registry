{
  "id": "windsurf",
  "name": "Windsurf",
  "order": 70,
  "description": "AI IDE by Cognition (formerly Codeium).",
  "detect": {
    "commands": [
      "windsurf"
    ],
    "paths": [
      "{home}/.codeium/windsurf"
    ]
  },
  "kinds": {
    "mcp": {
      "support": "auto",
      "transports": [
        "stdio",
        "http",
        "sse"
      ],
      "default_scope": "user",
      "shape": {
        "stdio": {
          "command": "{command}",
          "args": "{args}",
          "env": "{env}"
        },
        "http": {
          "serverUrl": "{url}",
          "headers": "{headers}"
        },
        "sse": {
          "serverUrl": "{url}",
          "headers": "{headers}"
        }
      },
      "env_ref": "${env:__NAME__}",
      "windows_wrap": "cmd",
      "methods": [
        {
          "method": "config-file",
          "format": "json",
          "root": [
            "mcpServers"
          ],
          "scopes": {
            "user": {
              "file": {
                "all": "{home}/.codeium/windsurf/mcp_config.json"
              }
            }
          }
        }
      ],
      "restart_required": true,
      "post_install": "Press refresh in Cascade > MCP servers or restart Windsurf.",
      "notes": "Global config only (no project scope)."
    },
    "skill": {
      "support": "guided",
      "default_scope": "user",
      "scopes": {
        "user": {
          "dir": {
            "all": "{home}/.codeium/windsurf/skills"
          }
        },
        "project": {
          "dir": {
            "all": "{project}/.windsurf/skills"
          }
        }
      },
      "notes": "Not verified. Confirm with the user, then pass --skills-dir."
    },
    "plugin": {
      "support": "none"
    },
    "extension": {
      "support": "guided"
    }
  },
  "verified": {
    "date": "2026-11-20",
    "confidence": "high",
    "sources": [
      "https://docs.windsurf.com/windsurf/cascade/mcp"
    ]
  }
}
