{
  "id": "qwen-code",
  "name": "Qwen Code",
  "order": 100,
  "description": "Alibaba's Gemini-CLI-based coding agent.",
  "detect": {
    "commands": [
      "qwen"
    ],
    "paths": [
      "{home}/.qwen"
    ]
  },
  "kinds": {
    "mcp": {
      "support": "guided",
      "transports": [
        "stdio",
        "http",
        "sse"
      ],
      "default_scope": "user",
      "shape": {
        "stdio": {
          "command": "{command}",
          "args": "{args}",
          "env": "{env}"
        },
        "http": {
          "httpUrl": "{url}",
          "headers": "{headers}"
        },
        "sse": {
          "url": "{url}",
          "headers": "{headers}"
        }
      },
      "windows_wrap": "cmd",
      "methods": [
        {
          "method": "config-file",
          "format": "json",
          "root": [
            "mcpServers"
          ],
          "scopes": {
            "user": {
              "file": {
                "all": "{home}/.qwen/settings.json"
              }
            },
            "project": {
              "file": {
                "all": "{project}/.qwen/settings.json"
              }
            }
          }
        }
      ],
      "notes": "Settings format follows Gemini CLI but is not verified. Confirm the file with the user, then pass --config-path to apply."
    },
    "skill": {
      "support": "none"
    },
    "plugin": {
      "support": "none"
    },
    "extension": {
      "support": "guided"
    }
  },
  "verified": {
    "date": "2026-11-20",
    "confidence": "low",
    "sources": []
  }
}
